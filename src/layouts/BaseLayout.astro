---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description?: string; active?: string }
const { title, description='Portfólio de Dados, BI e Transformação Digital de Kaíque Passaros', active='' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="pt-BR" data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/>
<meta name="theme-color" content="#151817"/><link rel="icon" href={`${base}assets/brand/favicon-32.png`}/><title>{title}</title>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('portfolio-theme')||'dark'}catch{}</script>
</head><body data-page={active}>
<canvas id="starfield" aria-hidden="true"></canvas><a class="skip" href="#conteudo">Ir para o conteúdo</a><Header active={active}/>
<main id="conteudo"><slot /></main><Footer/><script src={`${base}scripts/site.js`} defer></script>
</body></html>
